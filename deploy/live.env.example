# LIVE environment for ai-scalper-live.service
# Copy to /etc/ai-scalper/live.env, set 0600 root:root, fill in API keys.
# NEVER commit the real file to git.

# Bybit mainnet, REAL TRADING.
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_API_KEY=REPLACE_WITH_MAINNET_KEY
BYBIT_API_SECRET=REPLACE_WITH_MAINNET_SECRET

# Trading mode — false = real orders. Do NOT switch to true here.
BYBIT_PAPER_TRADING=false

# Configs scoped to live (calendar-spread only, aggressive disabled).
CONFIG_FILE=config.live-pipeline.json
AGGRESSIVE_CONFIG_FILE=config.aggressive.live.json

# Scope the pipeline to a single strategy. Comma-separated; empty = all six.
PIPELINE_STRATEGIES=calendar-spread

# Dedicated Redis DB — keeps live ledger/queues separate from paper (DB 0).
REDIS_URL=redis://127.0.0.1:6379/1

# Scanner schedule off — calendar-spread does not consume scan output.
SCAN_SCHEDULE_ENABLED=false

# WS feed on (calendar-spread does not need it but cheap, future strategies will).
USE_WEBSOCKET=true
WS_FEEDER_SYMBOLS=BTCUSDT

LOG_LEVEL=info
PATH=/home/assistant/.bun/bin:/usr/local/bin:/usr/bin:/bin
