# ── Secrets ──────────────────────────────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── API endpoints ─────────────────────────────────────────────────────────────
BYBIT_BASE_URL=https://api-testnet.bybit.com
BYBIT_SCAN_BASE_URL=https://api.bybit.com
BYBIT_RECV_WINDOW=5000

# ── Trading mode ──────────────────────────────────────────────────────────────
# Set BYBIT_PAPER_TRADING=false to send real orders
BYBIT_PAPER_TRADING=true
TRADER_MODE=trade
# 0 = run indefinitely; set to a small number (e.g. 25) for quick smoke tests
TRADER_MAX_TICKS=0

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
BULL_BOARD_PORT=3010
BULL_BOARD_BASE_PATH=/admin/queues

# ── Scanner (packages/market-scanner) ─────────────────────────────────────────
SCAN_LIMIT=10
SCAN_PREFILTER_LIMIT=25
SCAN_KLINE_INTERVAL=1
SCAN_KLINE_LIMIT=15
SCAN_SIGNAL_THRESHOLD_BPS=3
SCAN_OUTPUT_DIR=apps/trader/data
SCAN_TAKER_FEE_BPS=5.5
SCAN_ESTIMATED_SLIPPAGE_BPS=4
SCAN_MIN_NET_EDGE_BPS=4
SCAN_MAX_FUNDING_BPS=10
BACKTEST_CANDIDATE_LIMIT=5

# ── Worker / Queue ────────────────────────────────────────────────────────────
SCAN_JOB_TIMEOUT_MS=30000
SCAN_SCHEDULE_ENABLED=true
SCAN_SCHEDULE_MINUTES=5
SCAN_SCHEDULE_RUN_ON_START=true
CANDIDATE_BACKTEST_JOB_TIMEOUT_MS=15000
CANDIDATE_BACKTEST_HIGH_LIQUIDITY_PRIORITY=1
CANDIDATE_BACKTEST_HIGH_VOLATILITY_PRIORITY=2
CANDIDATE_BACKTEST_STANDARD_PRIORITY=3
CANDIDATE_BACKTEST_DEDUPE_WINDOW_MINUTES=30

# ── Trading parameters → edit apps/trader/config.json instead ─────────────────
# All strategy, risk, entry, wallet, scanner gate, and aggressive/exceptional
# params live in apps/trader/config.json and are committed to git.
# Env vars here override config.json values (useful for one-off overrides):
#
# TRADING_PROFILE=aggressive-perps
# ENTRY_EXECUTION_MODE=taker
# BYBIT_LEVERAGE=5
# STRATEGY_STOP_LOSS_BPS=30
# STRATEGY_TAKE_PROFIT_BPS=60

# ── Meta-bandit + Runtime (Thompson sampling over strategy variants) ─────────
# META_ENABLED=false                       # turn on Thompson-bandit shadow trading
# META_WARMUP_MIN_TRADES=5                 # min closed trades per variant before ranking
# META_PNL_WINDOW_SIZE=50                  # FIFO window of recent PnLs per variant
# META_INCLUDE_AGGRESSIVE_VARIANTS=false   # add 25x/50x/75x/100x variants to the pool
# RUNTIME_ARTIFACT_FLUSH_TICKS=30          # how often to flush allocator-state.json
# STATE_PERSISTENCE_ENABLED=false          # reserved for future use

# ── Phase 1B — Trailing stop, reconcile, drawdown, alerts, autotune ───────────
# TRAILING_STOP_ENABLED=false              # enable trailing stop loss
# TRAILING_STOP_ACTIVATION_BPS=30          # bps in-profit before trailing activates
# TRAILING_STOP_TRAIL_BPS=15               # trailing distance in bps
# POSITION_RECONCILE_INTERVAL_TICKS=30     # reconcile vs exchange every N ticks (live only)
# SET_TRADING_STOP_RETRY_MAX=3             # setTradingStop retry attempts
# SET_TRADING_STOP_RETRY_DELAY_MS=500      # base retry delay (exponential)
# DRAWDOWN_VELOCITY_WINDOW_MS=3600000      # rolling drawdown window (ms)
# DRAWDOWN_VELOCITY_MAX_USD=30             # max drawdown in window before halt
# DRAWDOWN_MAX_CONSECUTIVE_LOSSES=5        # consecutive losses -> halt
# CONFIDENCE_SIZING_ENABLED=false          # scale order USD by scan score / reference
# CONFIDENCE_SIZING_MIN_MULTIPLIER=0.5
# CONFIDENCE_SIZING_MAX_MULTIPLIER=2.0
# BANDIT_HALF_LIFE_DAYS=0                  # 0 = no time-decay on bandit PnL
# ALERT_WEBHOOK_URL=                       # Discord/generic alert webhook (empty = no-op)
# ALERT_THROTTLE_MS=60000                  # min ms between duplicate alerts
# SCAN_GATE_AUTO_TUNE_ENABLED=false        # adapt min net-edge from scan history
# SCAN_GATE_AUTO_TUNE_PERCENTILE=75        # 50, 75, or 90
# SCAN_GATE_AUTO_TUNE_FALLBACK_BPS=15      # used when no history exists yet
# SCAN_MIN_OPEN_INTEREST_USD=0             # scanner OI floor
# SCAN_MIN_LISTING_AGE_DAYS=0              # scanner symbol-age floor

# ── LLM order supervisor (opt-in pre-entry approval for low-freq strategies) ─
# ORDER_SUPERVISOR_ENABLED=false           # gate; also requires ANTHROPIC_API_KEY
# ORDER_SUPERVISOR_STRATEGIES=funding-arb,basis-arb,pairs-trading,calendar-spread
# ORDER_SUPERVISOR_MIN_CONFIDENCE=0.5      # treat low-confidence approvals as reject
# ORDER_SUPERVISOR_MODEL=claude-haiku-4-5-20251001
# ORDER_SUPERVISOR_TIMEOUT_MS=8000         # safe-reject if LLM call exceeds this
# ORDER_SUPERVISOR_ON_ERROR_BEHAVIOR=reject  # reject | approve (fail-safe default reject)
