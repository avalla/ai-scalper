# ── Secrets ──────────────────────────────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── API endpoints ─────────────────────────────────────────────────────────────
BYBIT_BASE_URL=https://api-testnet.bybit.com
BYBIT_SCAN_BASE_URL=https://api.bybit.com
BYBIT_RECV_WINDOW=5000

# ── Trading mode ──────────────────────────────────────────────────────────────
# Set BYBIT_PAPER_TRADING=false to send real orders
BYBIT_PAPER_TRADING=true
TRADER_MODE=trade
# 0 = run indefinitely; set to a small number (e.g. 25) for quick smoke tests
TRADER_MAX_TICKS=0

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
BULL_BOARD_PORT=3010
BULL_BOARD_BASE_PATH=/admin/queues

# ── Scanner (packages/market-scanner) ─────────────────────────────────────────
SCAN_LIMIT=10
SCAN_PREFILTER_LIMIT=25
SCAN_KLINE_INTERVAL=1
SCAN_KLINE_LIMIT=15
SCAN_SIGNAL_THRESHOLD_BPS=3
SCAN_OUTPUT_DIR=apps/trader/data
SCAN_TAKER_FEE_BPS=5.5
SCAN_ESTIMATED_SLIPPAGE_BPS=4
SCAN_MIN_NET_EDGE_BPS=4
SCAN_MAX_FUNDING_BPS=10
BACKTEST_CANDIDATE_LIMIT=5

# ── Worker / Queue ────────────────────────────────────────────────────────────
SCAN_JOB_TIMEOUT_MS=30000
SCAN_SCHEDULE_ENABLED=true
SCAN_SCHEDULE_MINUTES=5
SCAN_SCHEDULE_RUN_ON_START=true
CANDIDATE_BACKTEST_JOB_TIMEOUT_MS=15000
CANDIDATE_BACKTEST_HIGH_LIQUIDITY_PRIORITY=1
CANDIDATE_BACKTEST_HIGH_VOLATILITY_PRIORITY=2
CANDIDATE_BACKTEST_STANDARD_PRIORITY=3
CANDIDATE_BACKTEST_DEDUPE_WINDOW_MINUTES=30

# ── Trading parameters → edit apps/trader/config.json instead ─────────────────
# All strategy, risk, entry, wallet, scanner gate, and aggressive/exceptional
# params live in apps/trader/config.json and are committed to git.
# Env vars here override config.json values (useful for one-off overrides):
#
# TRADING_PROFILE=aggressive-perps
# ENTRY_EXECUTION_MODE=taker
# BYBIT_LEVERAGE=5
# STRATEGY_STOP_LOSS_BPS=30
# STRATEGY_TAKE_PROFIT_BPS=60
